<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Force HTTPS. The X-Forwarded-Proto guard prevents a redirect loop behind
    # LiteSpeed/proxy where %{HTTPS} may not reflect the edge TLS termination.
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Force non-www (e.g. www.belgradeluggagelocker.com -> belgradeluggagelocker.com).
    # Host-scoped: only fires when the host starts with "www.", so the staging
    # subdomain locker.webby.rs (no www variant) is never affected.
    RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

# Content-hashed Vite build assets (/build/...) are immutable — their filenames
# change on every rebuild, so cache them for a year. Scoped to /build/ only so it
# never touches /sw.js (must stay fresh) or non-hashed images in /images/.
<IfModule mod_setenvif.c>
    SetEnvIf Request_URI "^/build/" LL_IMMUTABLE_ASSET
</IfModule>
<IfModule mod_headers.c>
    Header set Cache-Control "public, max-age=31536000, immutable" env=LL_IMMUTABLE_ASSET

    # --- Security headers (target securityheaders.com grade A) ---
    # HSTS: force HTTPS for a year incl. subdomains. (No "preload" token on
    # purpose — that's an irreversible commitment that must be opted into.)
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(self), camera=(), microphone=(), payment=()"
</IfModule>

# Force CloudLinux alt-php-82 for this site only (per-folder, no global change).
# Required because ea-php84 on this account lacks the cURL extension the TTLock
# HTTP client needs. Kept in the repo so a server-side `git pull` can't silently
# revert the runtime. (Both staging + production live on this same cPanel host.)
AddHandler application/x-httpd-alt-php82___lsphp .php .php5 .phtml
